# ===========================================================================
# Meeting Intelligence Dashboard - Environment Variables
# ===========================================================================
# Copy to .env.local and fill in your values.
# See migration/sop.md Section B for procedures on adding/changing vars.
#
# RULE: When adding a new var, update this file AND both Vercel projects
# (dev + prod) AND migration/environments.md.
# ===========================================================================

# ---------------------------------------------------------------------------
# SUPABASE (Required)
# ---------------------------------------------------------------------------
# Dev: https://burcfsxsxgabknmodsrd.supabase.co
# Prod: https://cxrjlmquzhfueqrudiuy.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Found in: Supabase Dashboard > Settings > API > anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ---------------------------------------------------------------------------
# AI SERVICES (Required)
# ---------------------------------------------------------------------------
# Anthropic API key. Used by chat, email, prep, resummarize routes.
# Get at: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Gemini API key for embeddings (RAG search).
# Must match n8n pipeline's embedding model (gemini-embedding-001).
# Get at: aistudio.google.com
GEMINI_API_KEY=AIza...

# Claude model version for all LLM routes.
# Defaults to claude-sonnet-4-20250514 if unset.
# CHAT_MODEL=claude-sonnet-4-20250514

# ---------------------------------------------------------------------------
# SLACK (Optional - features hidden if missing)
# ---------------------------------------------------------------------------
# Incoming webhook URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# Bot OAuth token (scope: channels:read, chat:write)
# SLACK_BOT_TOKEN=xoxb-...

# Allowed channel names (comma-separated). Dev: meeting-intel-dev
# SLACK_ALLOWED_CHANNELS=meeting-intel-dev,mi-sales,mi-cs,mi-internal

# Section-specific notification channels (IDs from Slack)
# MI_SALES_CHANNEL_ID=C0B32H6C0SK
# MI_CS_CHANNEL_ID=C0B3BKT18P5
# MI_INTERNAL_CHANNEL_ID=C0B32HBD1M5

# ---------------------------------------------------------------------------
# RATE LIMITING (Optional - defaults applied if missing)
# ---------------------------------------------------------------------------
# Max Ask Blarney queries per user per day. Default: 50
# DAILY_QUERY_LIMIT=50

# Max queries per 5-minute window. Default: 10
# BURST_QUERY_LIMIT=10

# ---------------------------------------------------------------------------
# PIPELINE (Optional)
# ---------------------------------------------------------------------------
# Hours between n8n runs. Dev: 24, Prod: 8. Used for stale-data warnings.
NEXT_PUBLIC_PIPELINE_INTERVAL_HOURS=8

# ---------------------------------------------------------------------------
# TESTING (Only for E2E)
# ---------------------------------------------------------------------------
# Must match a Supabase auth user in the target project.
# TEST_EMAIL=neeraj@fullfunnel.co
# TEST_PASSWORD=testpass
